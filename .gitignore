# Raw data — download via reproduce/download_geo_data.sh
resources/

# Generated figures, result tables, and caches — regenerated by reproduce/run_all.sh.
# Only the non-regenerable inputs are tracked (BayesianOptimizer hyperparameters that
# came from a separate AutoML library, and the BRETIGEA marker table from R).
src/*.png
src/*.csv
src/*.txt
src/*.tsv
src/*.json
!src/lgbm_best_params.json
!src/lgbm_top500_best_params.json
!src/bretigea_markers.csv

# Large regenerable artifacts (e.g. the pre-filtered feature matrix)
*.npy

# Binary model / data caches
*.pkl
*.joblib
*.h5
cache*/
optimizer_state*/

# Python
__pycache__/
*.pyc
*.pyo

# Logs
*.log
reproduce/logs/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.out
*.toc
*.fls
*.fdb_latexmk
